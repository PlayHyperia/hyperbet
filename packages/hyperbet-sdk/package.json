{
  "name": "@hyperbet/sdk",
  "version": "0.1.0",
  "description": "SOL-only Hyperbet TypeScript SDK for the Hyperia duel market",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "lint": "tsc --noEmit && prettier --check src tests *.ts *.json *.md",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.3",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
