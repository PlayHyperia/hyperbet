VITE_SOLANA_CLUSTER=localnet
VITE_GAME_API_URL=http://127.0.0.1:5555
VITE_GAME_WS_URL=ws://127.0.0.1:5555/ws
# Exact bettor-facing source returned by Hyperia's /api/streaming/config.
# There is intentionally no platform/channel fallback.
VITE_STREAM_URL=
# Optional, explicitly reviewed ordered recovery sources only:
# VITE_STREAM_SOURCES=https://your-stream-provider.example/live.m3u8
# Optional legacy two-source form. Prefer VITE_STREAM_SOURCES for deployment.
VITE_STREAM_FALLBACK_URL=
VITE_USE_GAME_RPC_PROXY=false
# Set false for spectator-only deployments and integration smokes. Public
# market data still renders, but the app receives no wallet signing authority.
# Defaults off. Explicit true is accepted only on localnet/devnet/testnet;
# the current source release cannot enable mainnet transaction authority.
VITE_TRANSACTIONS_ENABLED=false

# Keep provider keys on the keeper service. Public builds must not set
# VITE_SOLANA_RPC_URL to keyed provider URLs.
VITE_SOLANA_RPC_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Legacy single-headless-wallet mode
VITE_HEADLESS_WALLET_SECRET_KEY=
VITE_HEADLESS_WALLET_NAME=Headless Test Wallet
VITE_HEADLESS_WALLET_AUTO_CONNECT=false

# Multi-headless-wallet mode (JSON array). Takes precedence when set and is
# restricted to local E2E automation; never inject test private keys into a
# public Pages build.
# VITE_HEADLESS_WALLETS=[{"name":"E2E Wallet 1","secretKey":"<test-only-bs58-or-json-bytes>","autoConnect":true}]
VITE_HEADLESS_WALLETS=

# Optional launch-program overrides. When omitted, the app uses the checked-in
# Solana v1 deployment registry for VITE_SOLANA_CLUSTER.
VITE_FIGHT_ORACLE_PROGRAM_ID=
VITE_DUEL_MARKET_PROGRAM_ID=
VITE_MARKET_MAKER_SEED_SOL=
