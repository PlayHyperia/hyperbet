# =============================================================================
# Keeper Service — Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — point the keeper at the running Hyperia game server so it
# can pull live streaming state (agents, HP, cycle phase, leaderboard).
#
# Local dev (when `bun run dev` is running in the workspace root):
STREAM_STATE_SOURCE_URL=http://localhost:5555/api/streaming/state

# Production (replace with your deployed game server URL):
# STREAM_STATE_SOURCE_URL=https://your-game-server.up.railway.app/api/streaming/state
# ---------------------------------------------------------------------------

# Bearer token for STREAM_STATE_SOURCE_URL if the game server requires auth.
# Leave blank for open endpoints.
STREAM_STATE_SOURCE_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Arena / Bet recording
# ---------------------------------------------------------------------------
# Development/E2E-only key that can seed POST /api/arena/bet/record-external
# without a live transaction. Production and mainnet always require finalized
# on-chain place-order/event/native-transfer verification, even with this key.
ARENA_EXTERNAL_BET_WRITE_KEY=

# Development/E2E-only key for the streaming state push endpoint (defaults to
# ARENA_EXTERNAL_BET_WRITE_KEY). Publishing is disabled whenever the canonical
# STREAM_STATE_SOURCE_URL is configured and is always disabled in production.
STREAM_PUBLISH_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# Comma-separated extra CORS origins (localhost + hyperbet.win are always allowed).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# SQLite persistence
# ---------------------------------------------------------------------------
# Absolute or relative path to the keeper database file.
# Defaults to keeper.sqlite next to the src directory.
KEEPER_DB_PATH=./keeper.sqlite

# Maximum number of bet records to keep in memory (SQLite stores all of them).
BET_STORE_LIMIT=5000

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
SOLANA_CLUSTER=mainnet-beta
# NODE_ENV=production and NODE_ENV=staging both activate the same protected
# runtime-role, private-health authentication, and baked-release requirements.
# The current source release rejects mainnet duel-bot market creation before
# reading signer keys. There is intentionally no environment bypass until the
# legal eligibility, responsible-wagering, and market-integrity controls exist.
# Solana RPC URL (used for on-chain parser + Solana RPC proxy endpoint).
SOLANA_RPC_URL=
# Helius API key used for the dedicated Sender on mainnet and as the default
# mainnet RPC fallback. Deployed devnet/testnet use their explicit RPC URL for
# preflighted signed-transaction submission instead.
HELIUS_API_KEY=

# The HTTP service uses an ephemeral, read-only parser wallet. Never give the
# service a keeper or config authority keypair.

# Optional program ID overrides. When omitted, the keeper uses the checked-in
# Solana v1 deployment registry for SOLANA_CLUSTER.
FIGHT_ORACLE_PROGRAM_ID=
DUEL_MARKET_PROGRAM_ID=

# Required on both production Railway services. This must equal the lowercase
# SHA-256 digest bound to realValueProgramVerification in the canonical Solana
# v1 registry after independent mainnet program verification. It is not an
# activation flag; an unverified registry or any on-chain identity/config drift
# still fails closed.
SOLANA_MAINNET_PROGRAM_VERIFICATION_SHA256=

# Required on every non-local rail: the public upgrade authority expected for
# each deployed program. Set a value to `immutable` only after its upgrade
# authority has intentionally been removed. A shared value may be supplied as
# SOLANA_EXPECTED_UPGRADE_AUTHORITY, but explicit per-program values are safer.
FIGHT_ORACLE_EXPECTED_UPGRADE_AUTHORITY=
DUEL_MARKET_EXPECTED_UPGRADE_AUTHORITY=
# SOLANA_EXPECTED_UPGRADE_AUTHORITY=

# ---------------------------------------------------------------------------
# Dedicated duel keeper (run as a private service with HYPERBET_RUNTIME_ROLE=duel-bot)
# ---------------------------------------------------------------------------
# API service: `service`. Dedicated signer process: `duel-bot`.
HYPERBET_RUNTIME_ROLE=service
# Both services must share a strong token. The duel bot protects its internal
# snapshot with it; the API uses it to authenticate to KEEPER_BOT_HEALTH_URL.
KEEPER_BOT_HEALTH_BEARER_TOKEN=
# API service only. Railway private networking may use HTTP only for a
# `*.railway.internal` hostname and must target exactly /health/snapshot.
KEEPER_BOT_HEALTH_URL=http://your-duel-bot.railway.internal/health/snapshot
KEEPER_BOT_HEALTH_POLL_MS=2000
KEEPER_BOT_HEALTH_TIMEOUT_MS=3000

# Duel-bot service only. Railway supplies PORT; BOT_HEALTH_PORT is an optional
# explicit override for local process-isolation tests.
BOT_HEALTH_PORT=
# Every non-local rail requires distinct wallets for each automated role below;
# its fee treasury must also be independent from these identities. Keypair
# values accept a JSON file path, inline JSON secret array, or base64: secret.
KEEPER_FEE_PAYER_KEYPAIR=
ORACLE_REPORTER_KEYPAIR=
ORACLE_FINALIZER_KEYPAIR=
CLOB_MARKET_OPERATOR_KEYPAIR=
MARKET_MAKER_KEYPAIR=

# Public address only. The automated keeper must never possess this private key.
ORACLE_CHALLENGER_WALLET=

# Cold/config keys are optional during normal operation. Supply them only when
# initializing or intentionally updating an unfrozen on-chain config.
ORACLE_CONFIG_AUTHORITY_KEYPAIR=
CLOB_CONFIG_AUTHORITY_KEYPAIR=

# Exact localnet may use loopback HTTP. Every non-local rail requires an HTTPS
# authoritative game URL and this bearer credential.
GAME_URL=http://localhost:5555
BET_SYNC_SOURCE_BEARER_TOKEN=
TRADE_TREASURY_WALLET=
TRADE_MARKET_MAKER_WALLET=
# Only exact localnet may derive these two recipients from its diagnostic
# signers. Every other rail requires explicit recipient wallets. Fee values
# remain blank until the exact economics and dispute policy are approved; every
# non-local rail requires the approval flag to be exactly true.
SOLANA_LAUNCH_FEE_POLICY_APPROVED=
SOLANA_ORACLE_DISPUTE_WINDOW_SECS=
TRADE_TREASURY_FEE_BPS=
TRADE_MARKET_MAKER_FEE_BPS=
WINNINGS_MARKET_MAKER_FEE_BPS=
# Exact localnet alone may use diagnostic liquidity defaults. Every other rail
# requires this approval flag plus every exposure/price value below; populate
# them only from the signed launch economics/risk decision for that rail.
SOLANA_LAUNCH_MARKET_MAKER_RISK_APPROVED=
MARKET_MAKER_SEED_SOL=
MARKET_MAKER_MIN_QUOTE_SOL=
MARKET_MAKER_BID_PRICE=
MARKET_MAKER_ASK_PRICE=
MARKET_MAKER_MIN_QUOTE_PRICE_MILLIS=
MARKET_MAKER_MAX_QUOTE_PRICE_MILLIS=
MARKET_MAKER_MAX_INVENTORY_SOL_PER_SIDE=
MARKET_MAKER_MAX_NET_EXPOSURE_SOL=
MARKET_MAKER_MAX_GROSS_EXPOSURE_SOL=
MARKET_MAKER_MAX_SIDE_IMBALANCE_BPS=
MARKET_MAKER_MAX_DRAWDOWN_BPS=
# Material price/size changes may refresh after 5 seconds. Unchanged on-chain
# quotes are refreshed no more than once per 5 minutes to avoid needless rent,
# fees, book instability, and RPC load while health is re-evaluated each loop.
MARKET_MAKER_MIN_REFRESH_INTERVAL_MS=5000
MARKET_MAKER_MAX_QUOTE_AGE_MS=300000
BOT_LOOP=true
BOT_POLL_SECONDS=5
KEEPER_BOT_HEALTH_FILE=./.status/keeper-bot-health.json

# Persistent terminal reconciliation. Processing leases recover operations
# after crashes; retries are bounded and then require manual review.
TERMINAL_OPERATION_LEASE_MS=120000
TERMINAL_RETRY_BASE_MS=5000
TERMINAL_RETRY_MAX_MS=300000
TERMINAL_MAX_ATTEMPTS=25
TERMINAL_RECONCILE_BATCH_SIZE=10

# Re-enumerate canonical on-chain duel/market/order accounts after restart and
# periodically thereafter. The minimum accepted interval is 10 seconds.
MARKET_DISCOVERY_INTERVAL_MS=60000

# Revalidate immutable oracle/CLOB authority and fee configuration on-chain at
# this bounded interval instead of issuing the same reads on every keeper loop.
KEEPER_CONFIG_REVALIDATION_INTERVAL_MS=60000

# Deterministic market-account initialization may be retried only after an
# ambiguous confirmation and a confirmed account-existence check. Keep this
# bounded so a real validator outage still fails closed.
MARKET_INITIALIZATION_RECOVERY_TIMEOUT_MS=15000
MARKET_INITIALIZATION_MAX_ATTEMPTS=2
MARKET_INITIALIZATION_RETRY_DELAY_MS=1000

# Revalidate executable program accounts, canonical ProgramData linkage, loader
# ownership, and upgrade authorities at this interval (minimum 10 seconds).
PROGRAM_IDENTITY_CHECK_INTERVAL_MS=60000

# Durable finalized CLOB history begins at the verified deployment slot. This
# is mandatory and positive on every non-local rail and must never be moved
# forward after indexing starts. Exact localnet alone may omit it and use slot 0.
SOLANA_LIFECYCLE_INDEX_START_SLOT=
# RPC crawl/persistence bounds; any backlog is continued oldest-first next poll.
SOLANA_LIFECYCLE_INDEX_PAGE_SIZE=250
SOLANA_LIFECYCLE_INDEX_MAX_PAGES=25
SOLANA_LIFECYCLE_INDEX_BATCH_SIZE=250
# A just-submitted bet may be durably recorded before its transaction reaches
# the finalized index. Keep that bounded interval observable and readiness-safe;
# fail the parser/readiness once the oldest pending record exceeds this age.
# Minimum 5000 ms. Default 120000 ms.
SOLANA_LIFECYCLE_PENDING_MAX_AGE_MS=120000

# Manual recovery is CLI-only (never a public HTTP mutation route):
# bun run terminal-ops list
# bun run terminal-ops inspect <id>
# bun run terminal-ops requeue <id> --confirm-fingerprint <sha256> --actor <operator-id> --reason <justification>
# bun run terminal-ops history --id <id>
# bun run terminal-ops feed-status

# Keeper backoff tuning when Solana RPC or required programs are unavailable.
# Transient RPC failures retry exponentially from the base up to the cooldown.
# BOT_RPC_RETRY_BASE_MS=1000
# BOT_RPC_CHECK_COOLDOWN_MS=60000
# BOT_CHAIN_CHECK_COOLDOWN_MS=120000

# Item manifest CDN base URL.
ITEM_MANIFEST_BASE_URL=https://assets.hyperia.club/manifests/items

# ---------------------------------------------------------------------------
# Streaming state polling tuning
# ---------------------------------------------------------------------------
# How often to poll STREAM_STATE_SOURCE_URL (ms, min 1000).
STREAM_STATE_POLL_MS=2000

# Timeout for each poll request (ms, min 500).
STREAM_STATE_SOURCE_TIMEOUT_MS=3000

# Max backoff between retries after failures (ms).
STREAM_STATE_SOURCE_MAX_BACKOFF_MS=30000

# How often to poll Solana parser state (ms, min 5000).
CONTRACT_POLL_MS=15000

# Fail-closed readiness thresholds.
READINESS_STREAM_MAX_AGE_MS=15000
READINESS_BOT_MAX_AGE_MS=30000
# Independent liveness plus real SOL RPC probe cadence. Must remain below the
# bot readiness threshold so long terminal settlement cannot starve health.
KEEPER_BOT_HEALTH_HEARTBEAT_MS=5000
READINESS_PARSER_MAX_AGE_MS=30000

# ---------------------------------------------------------------------------
# Federated operator alerts (API service only)
# ---------------------------------------------------------------------------
# Every production non-local rail requires an explicit HTTPS route and every
# bounded timing value below. The optional bearer token is sent only in the
# Authorization header and is never included in public status or alert payloads.
# A signed query string is also supported, but fragments and URL credentials
# are not.
HYPERBET_OPERATOR_ALERT_WEBHOOK_URL=
HYPERBET_OPERATOR_ALERT_BEARER_TOKEN=
HYPERBET_OPERATOR_ALERT_ROUTE_ID=
HYPERBET_OPERATOR_ALERT_MONITOR_MS=5000
HYPERBET_OPERATOR_ALERT_REMINDER_MS=300000
HYPERBET_OPERATOR_ALERT_RETRY_MS=10000
HYPERBET_OPERATOR_ALERT_TIMEOUT_MS=2000
# Durable outbox and incident custody. Production containers pin this beneath
# persistent /app/data. Back up and restore it with the service database.
HYPERBET_OPERATOR_ALERT_STATE_FILE=./.status/operator-alert-state.json
# One-run authorization for the explicit operator-alert-probe CLI. Never keep
# this enabled on a service or in persistent production configuration.
HYPERBET_OPERATOR_ALERT_TEST_APPROVED=
