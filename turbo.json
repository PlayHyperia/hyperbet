{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.example"],
  "globalEnv": ["HYPERIA_REPOSITORY_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "app/dist/**", "target/idl/**", "target/types/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
